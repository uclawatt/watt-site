        <div class="container footer-container">
            <div class="text-center center-block footer-block">
                <br />
                <p class="footer-text dark-green">Follow us on social media and subscribe to our newsletter!</p>
                <a href="https://www.facebook.com/uclawatt/"><i id="social-fb" class="fab fa-facebook-square fa-3x social"></i></a>
                <a href="https://www.instagram.com/uclawatt/?hl=en"><i id="social-in" class="fab fa-instagram fa-3x social"></i></a>
                <a href="http://eepurl.com/b0lwSv"><i id="social-nl" class="fas fa-envelope fa-3x social"></i></a>
            </div>
        </div>

        <script id="officers-template" type="text/x-handlebars-template">
            \{{#each officers}}
            <div class="col sm-12 md-8 lg-8 person-wrapper">
                <div class="person-card">
                    <img class="profile-picture" src="\{{this.imgUrl}}" loading="lazy" decoding="async" alt="\{{this.name}}">
                    <h4>\{{this.name}}</h4>
                    <h5>\{{this.role}}</h5>
                    <p>\{{this.bio}}</p>
                </div>
            </div>
            \{{/each}}
        </script>
        <script src="//ajax.googleapis.com/ajax/libs/jquery/1.11.0/jquery.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/modernizr/2.8.2/modernizr.js"></script>
        <script src="//maxcdn.bootstrapcdn.com/bootstrap/3.3.1/js/bootstrap.min.js"></script>
        <script type='text/javascript' src='js/handlebars-v4.0.11.js'></script>
        <script type='text/javascript' src='js/main.js'></script>
    </body>

</html>
