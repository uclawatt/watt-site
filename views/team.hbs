{{> header}}
<div class="page-cover-photo" style="--img: url(../img/backgroundphotos/TTeam.png)">

</div>
<div class="page-body team-page">
    <div class="page-wrapper">
        <div class="page-content">
            <div class="card-title">2026-2027 Board Members</div>
            <section class="section">
                <div class="section-container">
                    <div class="container team-container column">
                        <div class="container team-container constrained">
                            <div class="grid align-start">
                                <div id="officers-mount">
                                    {{#each boardMembers}}
                                    <div class="col sm-12 md-8 lg-8 person-wrapper">
                                        <div class="person-card">
                                            <img class="profile-picture" src="{{image}}" width="480" height="640" loading="lazy" decoding="async" alt="Portrait of {{name}}">
                                            <h4>{{name}}</h4>
                                            {{#if role}}<h5>{{role}}</h5>{{/if}}
                                            {{#if caption}}<p class="officer-caption">{{caption}}</p>{{/if}}
                                        </div>
                                    </div>
                                    {{/each}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
{{> footer}}
